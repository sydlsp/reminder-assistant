<view class="page">
  <view class="intro">
    <view class="title">{{isEdit ? '编辑事项' : '添加一件要记住的事'}}</view>
    <view class="hint">{{isEdit ? '修改后确认保存。' : '输入内容后点击智能解析，或从微信消息导入。'}}</view>
  </view>

  <!-- 输入区 -->
  <view class="input-area">
    <view class="label content-label">事项内容</view>
    <textarea class="title-input" placeholder="例如：明天下午3点开会讨论需求" value="{{title}}" maxlength="180" auto-height bindinput="onTitleInput" />
    <view class="parse-row">
      <text class="parse-btn {{loadingParse ? 'loading' : ''}}" bindtap="parseTitle">{{loadingParse ? '解析中...' : '智能解析'}}</text>
      <button class="clipboard-btn" loading="{{loadingClipboard}}" bindtap="readClipboard">从微信导入</button>
    </view>
  </view>

  <!-- 确认卡片 -->
  <view wx:if="{{showPreview}}" class="preview-card">
    <view class="preview-header">
      <view class="preview-type type-{{type}}">{{previewTypeLabel}}</view>
      <text class="preview-edit" bindtap="toggleEditForm">{{showEditForm ? '收起修改' : '修改'}}</text>
    </view>
    <view class="preview-title">{{title}}</view>
    <view class="preview-meta">
      <text class="preview-date">{{previewDateLabel}}</text>
      <text wx:if="{{previewTimeLabel}}" class="preview-time">{{previewTimeLabel}}</text>
    </view>
    <view wx:if="{{location}}" class="preview-location">@ {{location}}</view>
    <view wx:if="{{type !== 'todo'}}" class="preview-remind">提前 {{remindBefore}} 分钟提醒</view>
  </view>

  <!-- 修改区（可折叠） -->
  <view wx:if="{{showEditForm}}" class="form">
    <view class="label">事务类型</view>
    <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="picker">{{typeOptions[typeIndex].label}} · {{typeOptions[typeIndex].desc}}</view>
    </picker>

    <view class="label" style="margin-top: 34rpx;">地点（选填）</view>
    <input class="location-input" placeholder="如：302会议室" value="{{location}}" maxlength="50" bindinput="onLocationInput" />

    <block wx:if="{{type === 'event'}}">
      <view class="form-row">
        <view class="field">
          <view class="label">日期</view>
          <picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="picker">{{date}}</view></picker>
        </view>
      </view>
      <view class="form-row">
        <view class="field">
          <view class="label">开始时间</view>
          <picker mode="time" value="{{time}}" bindchange="onTimeChange"><view class="picker">{{time}}</view></picker>
        </view>
        <view class="field">
          <view class="label">结束时间</view>
          <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange"><view class="picker">{{endTime}}</view></picker>
        </view>
      </view>
    </block>

    <block wx:elif="{{type === 'deadline'}}">
      <view class="form-row">
        <view class="field">
          <view class="label">截止日期</view>
          <picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="picker">{{date}}</view></picker>
        </view>
        <view class="field">
          <view class="label">截止时间</view>
          <picker mode="time" value="{{time}}" bindchange="onTimeChange"><view class="picker">{{time}}</view></picker>
        </view>
      </view>
    </block>

    <view wx:if="{{type !== 'todo'}}" class="label" style="margin-top: 34rpx;">提前提醒</view>
    <picker wx:if="{{type !== 'todo'}}" mode="selector" range="{{reminderOptions}}" value="{{reminderIndex}}" bindchange="onReminderChange">
      <view class="picker">提前 {{remindBefore}} 分钟</view>
    </picker>

    <view wx:if="{{type === 'deadline'}}" class="form-row overdue-reminder-row">
      <view>
        <view class="label">逾期提醒</view>
        <view class="field-hint">截止后仍未完成时提醒一次</view>
      </view>
      <switch checked="{{overdueReminder}}" color="#16735f" bindchange="onOverdueReminderChange" />
    </view>
  </view>

  <!-- 确认保存 -->
  <button wx:if="{{showPreview || showEditForm}}" class="save" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{saving ? '保存中...' : (isEdit ? '确认更新' : '确认并保存')}}</button>
  <button wx:if="{{isEdit}}" class="delete-item" bindtap="removeItem">删除此事项</button>
</view>
