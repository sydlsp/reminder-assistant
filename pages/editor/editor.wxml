<view class="page">
  <view class="intro">
    <view class="title">{{isEdit ? '编辑事项' : '添加一件要记住的事'}}</view>
    <view class="hint">{{isEdit ? '修改类型和内容后保存。' : '选择事务类型后再填写内容。'}}</view>
  </view>

  <button class="import-button" loading="{{loadingClipboard}}" bindtap="readClipboard">从剪贴板读取微信消息</button>
  <view wx:if="{{source === 'clipboard'}}" class="source-note">已从剪贴板导入，请确认类型和时间。</view>

  <view class="form">
    <view class="label">事务类型</view>
    <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="picker">{{typeOptions[typeIndex].label}} · {{typeOptions[typeIndex].desc}}</view>
    </picker>

    <view class="label" style="margin-top: 34rpx;">事项</view>
    <textarea class="title-input" placeholder="例如：明天下午跟进报价" value="{{title}}" maxlength="180" auto-height bindinput="onTitleInput" />

    <block wx:if="{{type === 'event'}}">
      <view class="form-row">
        <view class="field">
          <view class="label">日期</view>
          <picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="picker">{{date}}</view></picker>
        </view>
      </view>
      <view class="form-row">
        <view class="field">
          <view class="label">开始时间</view>
          <picker mode="time" value="{{time}}" bindchange="onTimeChange"><view class="picker">{{time}}</view></picker>
        </view>
        <view class="field">
          <view class="label">结束时间</view>
          <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange"><view class="picker">{{endTime}}</view></picker>
        </view>
      </view>
    </block>

    <block wx:elif="{{type === 'deadline'}}">
      <view class="form-row">
        <view class="field">
          <view class="label">截止日期</view>
          <picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="picker">{{date}}</view></picker>
        </view>
        <view class="field">
          <view class="label">截止时间</view>
          <picker mode="time" value="{{time}}" bindchange="onTimeChange"><view class="picker">{{time}}</view></picker>
        </view>
      </view>
    </block>

    <view wx:if="{{type !== 'todo'}}" class="label" style="margin-top: 34rpx;">提前提醒</view>
    <picker wx:if="{{type !== 'todo'}}" mode="selector" range="{{reminderOptions}}" value="{{reminderIndex}}" bindchange="onReminderChange">
      <view class="picker">提前 {{remindBefore}} 分钟</view>
    </picker>
  </view>
  <button class="save" bindtap="save">{{isEdit ? '更新事项' : '保存事项'}}</button>
  <view class="privacy">仅读取你主动复制的内容，用于生成此提醒草稿。</view>
</view>
