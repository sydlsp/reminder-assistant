.page { padding: 48rpx 32rpx 72rpx; }
.intro { margin-bottom: 38rpx; }
.title { color: #142c25; font-size: 42rpx; font-weight: 700; }
.hint { margin-top: 14rpx; color: #7c8985; font-size: 26rpx; }

/* 输入区 */
.input-area { margin-bottom: 28rpx; }
.content-label { margin-left: 4rpx; }
.title-input { box-sizing: border-box; width: 100%; min-height: 110rpx; margin-bottom: 14rpx; padding: 20rpx; background: #fff; border-radius: 16rpx; color: #1b2925; font-size: 29rpx; line-height: 1.5; box-shadow: 0 4rpx 20rpx rgba(23, 64, 52, .04); }
.parse-row { display: flex; gap: 16rpx; }
.parse-btn { display: inline-block; padding: 14rpx 28rpx; background: #e8f2f6; border-radius: 12rpx; color: #2b6f97; font-size: 25rpx; }
.parse-btn.loading { opacity: .6; }
.clipboard-btn { flex: 1; padding: 0; background: #e8f2ed; border-radius: 12rpx; color: #176b55; font-size: 25rpx; line-height: 56rpx; text-align: center; }
.voice-card { display: flex; align-items: center; gap: 18rpx; margin-top: 20rpx; padding: 22rpx 20rpx; border: 1rpx solid #dfe9e4; border-radius: 18rpx; background: #fff; box-shadow: 0 4rpx 20rpx rgba(23, 64, 52, .035); }
.voice-card.is-recording { border-color: #9bc9bb; background: #f1f8f5; }
.voice-copy { flex: 1; min-width: 0; }
.voice-title { color: #29443b; font-size: 25rpx; font-weight: 650; }
.voice-hint { margin-top: 5rpx; color: #84918c; font-size: 21rpx; line-height: 1.4; }
.voice-transcript { margin-top: 9rpx; overflow: hidden; color: #50635c; font-size: 22rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.voice-button { flex-shrink: 0; width: 176rpx; margin: 0; padding: 0; border-radius: 14rpx; background: #176b55; color: #fff; font-size: 23rpx; font-weight: 600; line-height: 68rpx; }
.voice-button[disabled] { opacity: .58; }
.voice-card.is-recording .voice-button { background: #d8645b; }
.voice-cancel { flex-shrink: 0; padding: 16rpx 4rpx; color: #8a9792; font-size: 22rpx; }

/* 确认卡片 */
.preview-card { margin-bottom: 28rpx; padding: 32rpx 28rpx; background: #fff; border-radius: 22rpx; box-shadow: 0 8rpx 32rpx rgba(23, 64, 52, .06); }
.preview-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.preview-type { display: inline-block; padding: 6rpx 20rpx; border-radius: 10rpx; font-size: 22rpx; font-weight: 600; }
.type-todo { background: #f0f2f5; color: #6e7c77; }
.type-event { background: #e0f0ea; color: #176b55; }
.type-deadline { background: #fdf0e3; color: #c76b2d; }
.preview-edit { color: #597ef7; font-size: 25rpx; }
.preview-title { color: #142c25; font-size: 32rpx; font-weight: 600; line-height: 1.45; margin-bottom: 18rpx; word-break: break-all; }
.preview-meta { display: flex; align-items: center; gap: 18rpx; margin-bottom: 12rpx; }
.preview-date { color: #4a5b55; font-size: 26rpx; }
.preview-time { color: #176b55; font-size: 26rpx; font-weight: 600; }
.preview-location { display: flex; align-items: center; margin-bottom: 12rpx; color: #8b7355; font-size: 24rpx; }
.preview-location::before { content: ''; display: inline-block; width: 12rpx; height: 12rpx; margin-right: 8rpx; background: #d4a853; border-radius: 50%; }
.preview-remind { color: #82908b; font-size: 23rpx; }

/* 修改区 */
.form { margin-bottom: 28rpx; padding: 32rpx 28rpx; background: #fff; border-radius: 22rpx; box-shadow: 0 8rpx 32rpx rgba(23, 64, 52, .06); }
.form .title-input { box-shadow: none; background: #f5f7f6; }
.location-input { box-sizing: border-box; width: 100%; height: 80rpx; padding: 20rpx; margin-bottom: 14rpx; background: #f5f7f6; border-radius: 16rpx; color: #263631; font-size: 27rpx; line-height: 40rpx; }
.label { margin: 0 0 16rpx; color: #6e7c77; font-size: 24rpx; }
.form-row { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.field { flex: 1; min-width: 0; }
.picker { overflow: hidden; padding: 20rpx; background: #f5f7f6; border-radius: 14rpx; color: #263631; font-size: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.overdue-reminder-row { align-items: center; justify-content: space-between; margin: -6rpx 0 8rpx; padding-top: 24rpx; border-top: 1rpx solid #edf0ee; }
.overdue-reminder-row .label { margin-bottom: 6rpx; }
.completion-state-row { align-items: center; justify-content: space-between; margin: 28rpx 0 0; padding-top: 24rpx; border-top: 1rpx solid #edf0ee; }
.completion-state-row .label { margin-bottom: 6rpx; }
.field-hint { color: #9aa49f; font-size: 22rpx; }

/* 保存 */
.save { margin-top: 8rpx; background: #176b55; border-radius: 20rpx; color: #fff; font-size: 30rpx; line-height: 96rpx; }
.delete-item { margin-top: 20rpx; background: transparent; color: #c45b54; font-size: 26rpx; line-height: 72rpx; }

/* 提醒确认弹窗：操作按钮为原生 tap，供微信订阅授权直接使用。 */
.reminder-modal-mask { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(20, 35, 29, .38); }
.reminder-modal { width: 100%; padding: 40rpx 32rpx calc(34rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 28rpx 28rpx 0 0; box-sizing: border-box; }
.reminder-modal-title { color: #142c25; font-size: 34rpx; font-weight: 700; }
.reminder-modal-copy { margin-top: 14rpx; color: #7c8985; font-size: 25rpx; line-height: 1.55; }
.reminder-modal-actions { display: flex; gap: 18rpx; margin-top: 34rpx; }
.reminder-modal-actions button { flex: 1; margin: 0; border-radius: 16rpx; font-size: 27rpx; line-height: 88rpx; }
.reminder-modal-skip { background: #edf2ef; color: #63726c; }
.reminder-modal-confirm { background: #176b55; color: #fff; }
