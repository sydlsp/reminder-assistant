/* ===== 整体布局 ===== */
.page-container {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.header-area {
  flex-shrink: 0;
  padding: 48rpx 32rpx 0;
}

.content-swiper {
  flex: 1;
}

.swiper-scroll {
  padding: 0 32rpx 80rpx;
}

/* ===== 共享头部 ===== */
.hero { padding: 12rpx 8rpx 38rpx; }
.eyebrow { color: #6c7774; font-size: 24rpx; letter-spacing: 2rpx; }
.headline { margin-top: 14rpx; color: #142c25; font-size: 48rpx; font-weight: 700; line-height: 1.28; }
.date { margin-top: 18rpx; color: #70807a; font-size: 26rpx; }
.date-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; padding: 12rpx; background: #fff; border-radius: 18rpx; }
.nav-button { width: 62rpx; color: #176b55; font-size: 52rpx; line-height: 58rpx; text-align: center; }
.selected-date { color: #263631; font-size: 27rpx; font-weight: 600; }
.calendar { margin-left: 6rpx; color: #84918d; }
.today-link { display: block; margin: 0 12rpx 32rpx; color: #176b55; font-size: 24rpx; text-align: center; }
.quick-actions { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.quick-actions button { flex: 1; border-radius: 20rpx; font-size: 27rpx; line-height: 84rpx; }
.primary { background: #176b55; color: #fff; }
.secondary { background: #e7eeeb; color: #176b55; }

/* 视图切换 tab */
.view-switch { display: flex; justify-content: center; gap: 32rpx; margin-bottom: 28rpx; }
.switch-tab { color: #84918d; font-size: 26rpx; padding: 4rpx 0; }
.switch-tab.active { color: #176b55; font-weight: 600; border-bottom: 4rpx solid #176b55; }

/* ===== 卡片视图 ===== */
.section { margin-bottom: 48rpx; }
.section-header { display: flex; align-items: center; gap: 14rpx; margin-bottom: 20rpx; }
.section-title { color: #263531; font-size: 30rpx; font-weight: 600; }
.section-badge { padding: 4rpx 16rpx; background: #e7eeeb; border-radius: 100rpx; color: #176b55; font-size: 22rpx; }
.empty-small { padding: 32rpx 24rpx; background: #fff; border-radius: 18rpx; color: #82908b; font-size: 25rpx; text-align: center; }

.event-list { display: flex; flex-direction: column; gap: 18rpx; }
.event-card { display: flex; gap: 24rpx; padding: 30rpx 24rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 8rpx 32rpx rgba(23, 64, 52, .05); }
.event-card.is-done { opacity: .55; }
.time { min-width: 86rpx; color: #176b55; font-size: 30rpx; font-weight: 700; }
.event-body { flex: 1; min-width: 0; }
.event-title { overflow: hidden; color: #1a2824; font-size: 30rpx; font-weight: 600; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.event-location { margin-top: 6rpx; color: #8b7355; font-size: 22rpx; }
.event-meta { margin-top: 10rpx; color: #82908b; font-size: 22rpx; }

/* 日程时间块卡片 */
.schedule-card { position: relative; display: flex; align-items: center; min-height: 108rpx; overflow: hidden; padding: 20rpx 24rpx 20rpx 0; background: #fff; border: 1rpx solid #edf2ef; border-radius: 18rpx; box-shadow: 0 6rpx 20rpx rgba(23, 64, 52, .04); }
.schedule-card::before { content: ''; align-self: stretch; width: 8rpx; margin-right: 20rpx; border-radius: 0 8rpx 8rpx 0; background: #2b8a6b; }
.schedule-time { display: flex; flex-direction: column; flex-shrink: 0; align-items: center; width: 92rpx; }
.schedule-start, .schedule-end { color: #176b55; font-size: 25rpx; font-weight: 600; line-height: 1.2; }
.schedule-time-line { width: 2rpx; height: 14rpx; margin: 5rpx 0; background: #c5ded5; }
.schedule-copy { flex: 1; min-width: 0; padding: 0 16rpx 0 18rpx; }
.schedule-title { overflow: hidden; color: #1a2824; font-size: 29rpx; font-weight: 600; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.schedule-meta { display: flex; align-items: center; margin-top: 10rpx; overflow: hidden; font-size: 21rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.schedule-location, .schedule-duration, .schedule-reminder { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.schedule-location { color: #8b7355; }
.schedule-duration { color: #5d8f7e; }
.schedule-reminder { color: #98a49f; }
.schedule-meta-separator { flex-shrink: 0; margin: 0 9rpx; color: #d6dfda; }
.schedule-complete { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; margin: 0 34rpx 0 10rpx; border: 2rpx solid #9bc9bb; border-radius: 50%; box-sizing: border-box; }
.schedule-complete-inner { width: 22rpx; height: 22rpx; border: 2rpx solid #176b55; border-radius: 50%; box-sizing: border-box; }
.schedule-complete-done { background: #dce9e4; border-color: #dce9e4; color: #4f8976; font-size: 25rpx; font-weight: 700; line-height: 1; }
.deadline-card { border-color: #f2e8df; }
.deadline-card::before { background: #d88746; }
.deadline-card .schedule-start, .deadline-card .schedule-end { color: #c76b2d; }
.deadline-card .schedule-time-line { background: #edcfb4; }
.todo-item-card { border-color: #e7ece9; }
.todo-item-card::before { background: #9eaca7; }
.schedule-card-done { min-height: 72rpx; padding-top: 14rpx; padding-bottom: 14rpx; box-shadow: none; opacity: .55; }
.schedule-card-done::before { background: #b6c6c0; }
.schedule-card-done .schedule-title { color: #66756f; font-size: 26rpx; font-weight: 500; text-decoration: line-through; }
.schedule-card-done .schedule-meta { margin-top: 5rpx; font-size: 20rpx; }

/* 已完成分组 */
.done-group { margin-top: 24rpx; }
.done-divider { padding: 16rpx 8rpx; color: #6c7774; font-size: 23rpx; border-top: 2rpx solid #dfe6e3; }

/* 操作按钮 */
.card-actions { display: flex; align-items: center; gap: 8rpx; margin-top: 22rpx; }
.action-pill { padding: 6rpx 20rpx; border-radius: 10rpx; font-size: 23rpx; font-weight: 600; }
.action-pill.complete { background: #e0f0ea; color: #176b55; }
.action-pill.postpone { background: #eef0f2; color: #5a6965; }
.action-sep { width: 2rpx; height: 24rpx; margin: 0 8rpx; background: #dce3e0; }
.action { color: #77847f; font-size: 23rpx; }
.action.edit { color: #597ef7; }
.action.delete { color: #d45252; font-size: 28rpx; font-weight: 600; padding: 0 6rpx; }

/* ===== 时间线视图 ===== */
.timeline-wrap { position: relative; padding: 56rpx 0 20rpx; }

/* 当前时间红线 */
.now-line { position: absolute; left: 0; right: 0; display: flex; align-items: center; height: 0; z-index: 4; pointer-events: none; }
.now-line::after { content: ''; position: absolute; left: 42rpx; right: 0; top: 50%; height: 2rpx; border-top: 2rpx dashed #FF5E5E; }
.now-dot { position: absolute; left: 35rpx; top: 50%; width: 16rpx; height: 16rpx; margin-top: -8rpx; background: #FF5E5E; border-radius: 50%; }
.now-label { position: absolute; left: 80rpx; top: 50%; transform: translateY(-50%); color: #FF5E5E; font-size: 22rpx; font-weight: 600; background: #F7F8FA; padding: 2rpx 10rpx; border-radius: 6rpx; }

.tl-node { display: flex; position: relative; z-index: 1; }
.tl-node:last-child .tl-line { display: none; }
.tl-node.is-done { opacity: .5; }

.tl-gutter { position: relative; width: 90rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; padding-top: 10rpx; }
.tl-time { color: #176b55; font-size: 24rpx; font-weight: 600; }
.tl-dot { position: relative; z-index: 2; width: 22rpx; height: 22rpx; margin: 6rpx 0; border-radius: 50%; font-size: 16rpx; line-height: 22rpx; text-align: center; }
.dot-event { background: #176b55; }
.dot-deadline { background: #c76b2d; color: #fff; }
.dot-done { background: #b6c6c0; color: #fff; font-size: 13rpx; font-weight: 700; }
.tl-line { position: absolute; top: 48rpx; bottom: -16rpx; left: 50%; width: 2rpx; background: #dce3e0; }

.tl-item { flex: 1; min-width: 0; margin: 0 24rpx 14rpx 20rpx; padding: 8rpx 0 18rpx; border-bottom: 1rpx solid #e3ebe7; }
.tl-main-row { display: flex; align-items: flex-start; min-height: 52rpx; }
.tl-copy { flex: 1; min-width: 0; padding: 2rpx 12rpx 0 0; }
.tl-title { overflow: hidden; color: #142c25; font-size: 28rpx; font-weight: 600; line-height: 1.38; text-overflow: ellipsis; white-space: nowrap; }
.tl-subline { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; overflow: hidden; color: #8b9692; font-size: 22rpx; line-height: 1.2; white-space: nowrap; }
.tl-location, .tl-duration { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tl-location { color: #8b7355; }
.tl-duration { color: #8b9692; }
.tl-sub-separator { color: #c3cfca; }
.tl-type-hint { flex-shrink: 0; margin: 2rpx 14rpx 0 0; padding: 3rpx 10rpx; border-radius: 8rpx; background: #fdf0e3; color: #c76b2d; font-size: 20rpx; line-height: 1.3; }
.timeline-complete { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin: 0 28rpx 0 0; border: 2rpx solid #9bc9bb; border-radius: 50%; box-sizing: border-box; }
.timeline-complete-inner { width: 20rpx; height: 20rpx; border: 2rpx solid #176b55; border-radius: 50%; box-sizing: border-box; }
.tl-done-divider { margin: 20rpx 0 16rpx; padding: 12rpx 0 12rpx 110rpx; }
.tl-node-compact .tl-gutter { padding-top: 12rpx; }
.tl-node-compact .tl-line { bottom: -8rpx; }
.tl-item-done { margin-bottom: 8rpx; padding-bottom: 12rpx; }
.tl-item-done .tl-title { color: #66756f; font-size: 25rpx; font-weight: 500; text-decoration: line-through; }
.tl-location-done { display: block; margin-top: 5rpx; color: #98a49f; font-size: 20rpx; }

/* 空状态 */
.empty { margin-top: 28rpx; padding: 74rpx 34rpx; background: #fff; border-radius: 24rpx; text-align: center; }
.empty-icon { color: #b6c6c0; font-size: 58rpx; }
.empty-title { margin-top: 18rpx; color: #30413b; font-size: 30rpx; font-weight: 600; }
.empty-copy { margin-top: 14rpx; color: #81908a; font-size: 25rpx; line-height: 1.6; }
