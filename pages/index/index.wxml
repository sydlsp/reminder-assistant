<view class="page-container" style="height: {{pageHeight}}px">
  <!-- ===== 共享头部 ===== -->
  <view class="header-area">
    <!-- 卡片视图 Hero -->
    <view wx:if="{{currentView === 0}}" class="hero">
      <view class="eyebrow">我的日程</view>
      <view class="headline">把每一天安排得更清楚。</view>
      <view class="date">{{scheduleLabel}} · 共 {{totalCount}} 项 · 已完成 {{completedCount}} 项</view>
    </view>

    <!-- 时间线 Hero -->
    <view wx:elif="{{currentView === 1}}" class="hero">
      <view class="eyebrow">时间线</view>
      <view class="headline">{{scheduleLabel}}</view>
      <view class="date">共 {{pendingTimeline.length + doneTimeline.length}} 项</view>
    </view>

    <!-- 月历 Hero -->
    <view wx:else class="hero">
      <view class="eyebrow">月度安排</view>
      <view class="headline">{{calendarTitle}}</view>
      <view class="date">日程与截止任务一目了然</view>
    </view>

    <view wx:if="{{currentView !== 2}}" class="date-nav">
      <text class="nav-button" data-offset="-1" bindtap="changeDay">‹</text>
      <picker mode="date" value="{{selectedDate}}" bindchange="selectDate">
        <view class="selected-date">{{scheduleLabel}} <text class="calendar">⌄</text></view>
      </picker>
      <text class="nav-button" data-offset="1" bindtap="changeDay">›</text>
    </view>
    <text wx:if="{{currentView !== 2 && !isToday}}" class="today-link" bindtap="goToday">回到今天</text>

    <view class="quick-actions">
      <button class="primary" bindtap="addEvent">＋ 添加事项</button>
      <button wx:if="{{currentView === 0}}" class="secondary" bindtap="importClipboard">从微信消息导入</button>
      <button wx:if="{{currentView === 2}}" class="secondary" bindtap="goCurrentMonth">回到本月</button>
    </view>

    <view class="view-switch">
      <text class="switch-tab {{cardTabClass}}" data-view="0" bindtap="switchView">卡片视图</text>
      <text class="switch-tab {{timelineTabClass}}" data-view="1" bindtap="switchView">时间线</text>
      <text class="switch-tab {{calendarTabClass}}" data-view="2" bindtap="switchView">月历</text>
    </view>
  </view>

  <!-- ===== Swiper 内容区 ===== -->
  <swiper class="content-swiper" style="height: {{swiperHeight}}px" current="{{currentView}}" bindchange="onSwiperChange" duration="300">
    <!-- 卡片视图 -->
    <swiper-item>
      <scroll-view scroll-y class="swiper-scroll" style="height: {{swiperHeight}}px" enhanced show-scrollbar="{{false}}">
        <!-- 日程安排 -->
        <view class="section">
          <view class="section-header">
            <view class="section-title">日程安排</view>
            <view class="section-badge">{{schedulesPending.length + schedulesDone.length}}</view>
          </view>

          <view wx:if="{{schedulesPending.length}}" class="event-list">
            <view wx:for="{{schedulesPending}}" wx:key="id" class="schedule-card" data-id="{{item.id}}" bindtap="editItem">
              <view class="schedule-time">
                <text class="schedule-start">{{item.startTime}}</text>
                <view class="schedule-time-line"></view>
                <text class="schedule-end">{{item.endTime}}</text>
              </view>
              <view class="schedule-copy">
                <view class="schedule-title">{{item.title}}</view>
                <view wx:if="{{item.locationLabel || item.durationLabel || item.reminderLabel}}" class="schedule-meta">
                  <text wx:if="{{item.locationLabel}}" class="schedule-location">{{item.locationLabel}}</text>
                  <text wx:if="{{item.hasLocationSeparator}}" class="schedule-meta-separator">·</text>
                  <text wx:if="{{item.durationLabel}}" class="schedule-duration">{{item.durationLabel}}</text>
                  <text wx:if="{{item.hasDurationSeparator}}" class="schedule-meta-separator">·</text>
                  <text wx:if="{{item.reminderLabel}}" class="schedule-reminder">{{item.reminderLabel}}</text>
                </view>
              </view>
              <view class="schedule-complete" data-id="{{item.id}}" catchtap="complete"><view class="schedule-complete-inner"></view></view>
            </view>
          </view>

          <view wx:if="{{schedulesDone.length}}" class="done-group">
            <view class="done-divider">已完成</view>
            <view class="event-list">
              <view wx:for="{{schedulesDone}}" wx:key="id" class="schedule-card schedule-card-done" data-id="{{item.id}}" bindtap="editItem">
                <view class="schedule-time">
                  <text class="schedule-start">{{item.startTime}}</text>
                  <view class="schedule-time-line"></view>
                  <text class="schedule-end">{{item.endTime}}</text>
                </view>
                <view class="schedule-copy">
                  <view class="schedule-title">{{item.title}}</view>
                  <view wx:if="{{item.location}}" class="schedule-meta">@ {{item.location}}</view>
                </view>
                <view class="schedule-complete schedule-complete-done">✓</view>
              </view>
            </view>
          </view>

          <view wx:if="{{schedulesPending.length === 0 && schedulesDone.length === 0}}" class="empty-small">暂无日程安排</view>
        </view>

        <!-- 截止任务 -->
        <view class="section">
          <view class="section-header">
            <view class="section-title">截止任务</view>
            <view class="section-badge">{{deadlinesPending.length + deadlinesDone.length}}</view>
          </view>

          <view wx:if="{{deadlinesPending.length}}" class="event-list">
            <view wx:for="{{deadlinesPending}}" wx:key="id" class="schedule-card deadline-card" data-id="{{item.id}}" bindtap="editItem">
              <view class="schedule-time">
                <text class="schedule-start">{{item.startTime}}</text>
                <view class="schedule-time-line"></view>
                <text class="schedule-end">{{item.endTime}}</text>
              </view>
              <view class="schedule-copy">
                <view class="schedule-title">{{item.title}}</view>
                <view wx:if="{{item.locationLabel || item.reminderLabel}}" class="schedule-meta">
                  <text wx:if="{{item.locationLabel}}" class="schedule-location">{{item.locationLabel}}</text>
                  <text wx:if="{{item.hasLocationSeparator}}" class="schedule-meta-separator">·</text>
                  <text wx:if="{{item.reminderLabel}}" class="schedule-reminder">{{item.reminderLabel}}</text>
                </view>
              </view>
              <view class="schedule-complete" data-id="{{item.id}}" catchtap="complete"><view class="schedule-complete-inner"></view></view>
            </view>
          </view>

          <view wx:if="{{deadlinesDone.length}}" class="done-group">
            <view class="done-divider">已完成</view>
            <view class="event-list">
              <view wx:for="{{deadlinesDone}}" wx:key="id" class="schedule-card deadline-card schedule-card-done" data-id="{{item.id}}" bindtap="editItem">
                <view class="schedule-time">
                  <text class="schedule-start">{{item.startTime}}</text>
                  <view class="schedule-time-line"></view>
                  <text class="schedule-end">{{item.endTime}}</text>
                </view>
                <view class="schedule-copy">
                  <view class="schedule-title">{{item.title}}</view>
                  <view wx:if="{{item.location}}" class="schedule-meta">@ {{item.location}}</view>
                </view>
                <view class="schedule-complete schedule-complete-done">✓</view>
              </view>
            </view>
          </view>

          <view wx:if="{{deadlinesPending.length === 0 && deadlinesDone.length === 0}}" class="empty-small">暂无截止任务</view>
        </view>

        <!-- 待办事务 -->
        <view class="section">
          <view class="section-header">
            <view class="section-title">待办事务</view>
            <view class="section-badge">{{todosPending.length + todosDone.length}}</view>
          </view>

          <view wx:if="{{todosPending.length}}" class="event-list">
            <view wx:for="{{todosPending}}" wx:key="id" class="schedule-card todo-item-card" data-id="{{item.id}}" bindtap="editItem">
              <view class="schedule-copy">
                <view class="schedule-title">{{item.title}}</view>
                <view wx:if="{{item.locationLabel}}" class="schedule-meta"><text class="schedule-location">{{item.locationLabel}}</text></view>
              </view>
              <view class="schedule-complete" data-id="{{item.id}}" catchtap="complete"><view class="schedule-complete-inner"></view></view>
            </view>
          </view>

          <view wx:if="{{todosDone.length}}" class="done-group">
            <view class="done-divider">已完成</view>
            <view class="event-list">
              <view wx:for="{{todosDone}}" wx:key="id" class="schedule-card todo-item-card schedule-card-done" data-id="{{item.id}}" bindtap="editItem">
                <view class="schedule-copy">
                  <view class="schedule-title">{{item.title}}</view>
                  <view wx:if="{{item.location}}" class="schedule-meta">@ {{item.location}}</view>
                </view>
                <view class="schedule-complete schedule-complete-done">✓</view>
              </view>
            </view>
          </view>

          <view wx:if="{{todosPending.length === 0 && todosDone.length === 0}}" class="empty-small">暂无待办事务</view>
        </view>
      </scroll-view>
    </swiper-item>

    <!-- 时间线视图 -->
    <swiper-item>
      <scroll-view scroll-y class="swiper-scroll" style="height: {{swiperHeight}}px" enhanced show-scrollbar="{{false}}">
        <view wx:if="{{hasTimelineItems}}" class="timeline-wrap">
          <!-- 未完成 -->
          <block wx:for="{{pendingTimeline}}" wx:key="id">
            <view wx:if="{{item.showNowBefore}}" class="now-marker">
              <view class="now-marker-gutter"><view class="now-marker-dot"></view></view>
              <view class="now-marker-content"><view class="now-marker-dash"></view><view class="now-marker-label">{{nowLabel}}</view><view class="now-marker-dash"></view></view>
            </view>

            <view class="tl-node {{item.isOngoing ? 'is-ongoing' : ''}}">
              <view class="tl-gutter">
                <view class="tl-time">{{item.timeLabel}}</view>
                <view class="tl-dot {{item.type === 'deadline' ? 'dot-deadline' : 'dot-event'}}">
                  {{item.type === 'deadline' ? '⚑' : ''}}
                </view>
                <view class="tl-line"></view>
              </view>
              <view class="tl-item" data-id="{{item.id}}" bindtap="editItem">
                <view class="tl-main-row">
                  <view class="tl-copy">
                    <view class="tl-title">{{item.title}}</view>
                    <view wx:if="{{item.location || item.timelineMeta}}" class="tl-subline">
                      <text wx:if="{{item.location}}" class="tl-location">@ {{item.location}}</text>
                      <text wx:if="{{item.location && item.timelineMeta}}" class="tl-sub-separator">·</text>
                      <text wx:if="{{item.timelineMeta}}" class="tl-duration">{{item.timelineMeta}}</text>
                    </view>
                    <view wx:if="{{item.isOngoing || item.hasConflict}}" class="tl-status-row">
                      <text wx:if="{{item.isOngoing}}" class="tl-ongoing">进行中 · {{item.remainingLabel}}</text>
                      <text wx:if="{{item.hasConflict}}" class="tl-conflict">{{item.conflictLabel}}</text>
                    </view>
                  </view>
                  <text wx:if="{{item.type === 'deadline'}}" class="tl-type-hint">截止</text>
                  <view class="timeline-complete" data-id="{{item.id}}" catchtap="complete">
                    <view class="timeline-complete-inner"></view>
                  </view>
                </view>
              </view>
            </view>

            <view wx:if="{{item.showNowAfter}}" class="now-marker">
              <view class="now-marker-gutter"><view class="now-marker-dot"></view></view>
              <view class="now-marker-content"><view class="now-marker-dash"></view><view class="now-marker-label">{{nowLabel}}</view><view class="now-marker-dash"></view></view>
            </view>
          </block>

          <view wx:if="{{nowMarkerAfterList}}" class="now-marker">
            <view class="now-marker-gutter"><view class="now-marker-dot"></view></view>
            <view class="now-marker-content"><view class="now-marker-dash"></view><view class="now-marker-label">{{nowLabel}}</view><view class="now-marker-dash"></view></view>
          </view>

          <!-- 已完成 -->
          <block wx:if="{{doneTimeline.length}}">
            <view class="done-divider tl-done-divider">已完成</view>
            <block wx:for="{{doneTimeline}}" wx:key="id">
              <view class="tl-node is-done tl-node-compact">
                <view class="tl-gutter">
                  <view class="tl-time">{{item.timeLabel}}</view>
                  <view class="tl-dot dot-done">✓</view>
                  <view class="tl-line"></view>
                </view>
                <view class="tl-item tl-item-done" data-id="{{item.id}}" bindtap="editItem">
                  <view class="tl-main-row">
                    <view class="tl-copy">
                      <text class="tl-title">{{item.title}}</text>
                      <text wx:if="{{item.location}}" class="tl-location tl-location-done">@ {{item.location}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </block>
        </view>

        <view wx:else class="empty">
          <view class="empty-icon">—</view>
          <view class="empty-title">这一天暂无安排</view>
          <view class="empty-copy">点击「添加事项」为这一天安排日程或截止任务吧</view>
        </view>
      </scroll-view>
    </swiper-item>

    <!-- 月历视图 -->
    <swiper-item>
      <scroll-view scroll-y class="swiper-scroll" style="height: {{swiperHeight}}px" enhanced show-scrollbar="{{false}}">
        <view class="calendar-month-nav">
          <text class="calendar-month-button" data-offset="-1" bindtap="changeMonth">‹</text>
          <view class="calendar-month-title">{{calendarTitle}}</view>
          <text class="calendar-month-button" data-offset="1" bindtap="changeMonth">›</text>
        </view>

        <view class="calendar-board">
          <view class="calendar-weekdays">
            <text wx:for="{{calendarWeekdays}}" wx:key="*this" class="calendar-weekday">{{item}}</text>
          </view>
          <view wx:for="{{calendarWeeks}}" wx:for-item="week" wx:key="key" class="calendar-week">
            <view wx:for="{{week.days}}" wx:for-item="day" wx:key="key" class="calendar-day {{day.isCurrentMonth ? '' : 'is-other-month'}}" data-date="{{day.key}}" bindtap="selectCalendarDay">
              <view class="calendar-day-number {{day.isToday ? 'is-today' : ''}} {{day.isSelected ? 'is-selected' : ''}}">{{day.day}}</view>
              <view class="calendar-dots">
                <view wx:if="{{day.hasSchedules}}" class="calendar-dot dot-schedule"></view>
                <view wx:if="{{day.hasDeadlines}}" class="calendar-dot dot-deadline"></view>
              </view>
              <text wx:if="{{day.itemCount > 1}}" class="calendar-count">{{day.itemCount}}</text>
            </view>
          </view>
        </view>

        <view class="calendar-legend">
          <view class="calendar-legend-item"><view class="calendar-dot dot-schedule"></view><text>日程</text></view>
          <view class="calendar-legend-item"><view class="calendar-dot dot-deadline"></view><text>截止任务</text></view>
        </view>

        <view class="calendar-todo-card">
          <view class="calendar-todo-icon">✓</view>
          <view><view class="calendar-todo-title">未安排日期的待办</view><view class="calendar-todo-copy">还有 {{calendarTodoCount}} 项待办等待完成</view></view>
        </view>
        <view class="calendar-tip">点击日期，即可查看当天的详细安排</view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
